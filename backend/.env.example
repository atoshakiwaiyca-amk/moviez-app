# Nakili faili hii kuwa ".env" kisha jaza thamani zako mwenyewe

# Siri ya kutengeneza JWT tokens - badilisha na string ndefu ya ajabu
JWT_SECRET=badilisha_hii_na_siri_ndefu_isiyoweza_kubashiriwa

# Muda wa kuisha kwa login token (kwa saa)
JWT_EXPIRES_IN=7d

# Muda wa kuisha kwa signed download link (dakika) - usalama wa kuzuia link kushirikiwa
DOWNLOAD_LINK_EXPIRES_MIN=15

# Port ya server
PORT=4000

# Email na password ya admin wa kwanza (itaundwa automatic mara ya kwanza server ikianzishwa)
ADMIN_EMAIL=admin@moviez.co.tz
ADMIN_PASSWORD=BadilishaHiiSasa123!

# --- Malipo (Payment Gateway) ---
# Hapa ndipo utakapoweka funguo za kampuni ya malipo unayotumia
# Kwa mfano Stripe:
# STRIPE_SECRET_KEY=sk_live_xxxxx
# Kwa mfano M-Pesa/Tigo Pesa/Airtel Money: utahitaji akaunti ya Merchant (API keys)
# huduma hizi za simu ni kwa nchi husika (Tanzania) na zinahitaji usajili maalum
PAYMENT_PROVIDER=manual
